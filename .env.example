# pr-review-bot — environment template
# Copy to .env and fill in real values. Never commit .env.

# ─── LLM provider (OpenAI-compatible) ───────────────────────────────────────
# Endpoint for MiniMax-M3. Override here for any OpenAI-compatible provider.
OPENAI_BASE_URL=https://api.minimax.io/v1
# Your MiniMax API key. Get one at https://platform.minimax.io/
OPENAI_KEY=<your-minimax-api-key>

# ─── GitLab instance ────────────────────────────────────────────────────────
# Internal GitLab URL.
GITLAB_URL=https://gitlab.winwin.travel
# Personal Access Token with `api` scope, owned by a dedicated service account.
# Create one at: GitLab → User Settings → Access Tokens
GITLAB_TOKEN=<your-gitlab-pat-with-api-scope>

# ─── Webhook ────────────────────────────────────────────────────────────────
# Shared secret between GitLab webhook and this bot.
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>

# ─── PR-Agent config (inside container) ─────────────────────────────────────
# Path to configuration.toml mounted into the container.
PR_AGENT_CONFIG=/app/configuration.toml

# ─── Container networking ───────────────────────────────────────────────────
# Port the webhook listens on inside the container.
PR_AGENT_PORT=3000

# ─── Slack notifications (optional, sidecar service) ────────────────────────
# Empty = notifications disabled (bot still comments on GitLab, just no Slack).
# Generate at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Numeric GitLab user ID of the bot account. Only comments authored by this
# user trigger Slack notifications. Find it in GitLab → User profile → API.
GITLAB_BOT_USER_ID=

# ─── Webhook security (T19) ─────────────────────────────────────────────────
# Used by BOTH pr-agent and slack-notifier to validate X-Gitlab-Token header.
# Set this in GitLab webhook settings → "Secret token".
# Rotate together (GitLab UI + this env var) — see README.
# Already declared above as WEBHOOK_SECRET.

# ─── Secrets resolution (T29) ──────────────────────────────────────────────
# Each empty value above is ALSO checked against Windows Credential Manager.
# To store a secret in CredMan instead of .env (more secure on shared
# machines), use cmdkey with target prefix "pr-review-bot:":
#
#   cmdkey /generic:pr-review-bot:SLACK_WEBHOOK_URL /user:<your-webhook-url>
#   cmdkey /generic:pr-review-bot:WEBHOOK_SECRET      /user:<your-secret>
#   cmdkey /generic:pr-review-bot:OPENAI_KEY          /user:<your-minimax-key>
#   cmdkey /generic:pr-review-bot:GITLAB_TOKEN       /user:<your-gitlab-pat>
#   cmdkey /generic:pr-review-bot:JIRA_TOKEN         /user:<your-jira-pat>
#
# Resolution order: env var > Windows Credential Manager > empty/disabled.
# Windows-only; on Linux/macOS the CredMan step silently returns None.
