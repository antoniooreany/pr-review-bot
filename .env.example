# pr-review-bot — environment template
# Copy to .env and fill in real values. Never commit .env.

# ─── LLM provider (OpenAI-compatible) ───────────────────────────────────────
# Endpoint for MiniMax-M3. Override here for any OpenAI-compatible provider.
OPENAI_BASE_URL=https://api.minimax.io/v1
# Your MiniMax API key. Get one at https://platform.minimax.io/
OPENAI_KEY=<your-minimax-api-key>

# ─── GitLab instance ────────────────────────────────────────────────────────
# Internal GitLab URL.
GITLAB_URL=https://gitlab.winwin.travel
# Personal Access Token with `api` scope, owned by a dedicated service account.
# Create one at: GitLab → User Settings → Access Tokens
GITLAB_TOKEN=<your-gitlab-pat-with-api-scope>

# ─── Webhook ────────────────────────────────────────────────────────────────
# Shared secret between GitLab webhook and this bot.
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>

# ─── PR-Agent config (inside container) ─────────────────────────────────────
# Path to configuration.toml mounted into the container.
PR_AGENT_CONFIG=/app/configuration.toml

# ─── Container networking ───────────────────────────────────────────────────
# Port the webhook listens on inside the container.
PR_AGENT_PORT=3000
